
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Changed Successfully</title>
</head>

<body style="margin:0; padding:0; background-color:#f3f4f6; font-family:Arial,Helvetica,sans-serif; color:#1f2937;">

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
    style="background-color:#f3f4f6; padding:32px 12px;">
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
          style="max-width:560px; background-color:#ffffff; border-radius:16px; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td align="center"
              style="background-color:#111827; padding:30px 24px;">

              <h1 style="margin:0; color:#ffffff; font-size:25px; letter-spacing:-0.5px;">
                Password Changed Successfully
              </h1>

              <p style="margin:10px 0 0; color:#d1d5db; font-size:14px; line-height:22px;">
                Your account security matters to us
              </p>

            </td>
          </tr>

          <!-- Email Content -->
          <tr>
            <td style="padding:32px 28px 24px;">

              <p style="margin:0 0 18px; font-size:16px; line-height:25px;">
                Hello <strong><%= userName %></strong>,
              </p>

              <p style="margin:0 0 24px; color:#4b5563; font-size:14px; line-height:24px;">
                This email confirms that your account password has been changed successfully.
                You can now sign in using your new password.
              </p>

              <!-- Success Message -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
                style="background-color:#f0fdf4; border:1px solid #bbf7d0; border-radius:12px;">
                <tr>
                  <td align="center" style="padding:24px 16px;">

                    <div style="display:inline-block; width:48px; height:48px; line-height:48px; border-radius:50%; background-color:#dcfce7; color:#15803d; font-size:28px; font-weight:bold;">
                      &#10003;
                    </div>

                    <h2 style="margin:16px 0 8px; color:#166534; font-size:20px;">
                      Password Updated
                    </h2>

                    <p style="margin:0; color:#166534; font-size:14px; line-height:22px;">
                      Your password has been securely updated.
                    </p>

                  </td>
                </tr>
              </table>

              <p style="margin:24px 0 16px; color:#4b5563; font-size:14px; line-height:23px;">
                If you made this change, no further action is required.
                For your security, never share your password with anyone.
              </p>

              <!-- Security Warning -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
                style="background-color:#fff7ed; border-left:4px solid #f97316; border-radius:6px;">
                <tr>
                  <td style="padding:16px;">

                    <p style="margin:0 0 6px; color:#9a3412; font-size:14px; font-weight:bold;">
                      Didn't change your password?
                    </p>

                    <p style="margin:0; color:#9a3412; font-size:13px; line-height:22px;">
                      If you did not make this change, your account may be at risk.
                      Please reset your password immediately and contact our support team
                      if you notice any suspicious activity.
                    </p>

                  </td>
                </tr>
              </table>

              <p style="margin:28px 0 0; color:#4b5563; font-size:14px; line-height:23px;">
                Best regards,<br />
                <strong>The Support Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center"
              style="padding:20px 24px; background-color:#f9fafb; border-top:1px solid #e5e7eb;">

              <p style="margin:0; color:#9ca3af; font-size:12px; line-height:20px;">
                This is an automated email. Please do not reply to this message.
              </p>

              <p style="margin:8px 0 0; color:#9ca3af; font-size:11px;">
                &copy; <%= new Date().getFullYear() %> Your Application. All rights reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
