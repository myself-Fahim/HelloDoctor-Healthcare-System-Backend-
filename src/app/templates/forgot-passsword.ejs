
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Reset OTP</title>
</head>

<body style="margin:0; padding:0; background-color:#f3f4f6; font-family:Arial,Helvetica,sans-serif; color:#1f2937;">

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
    style="background-color:#f3f4f6; padding:32px 12px;">
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
          style="max-width:560px; background-color:#ffffff; border-radius:16px; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td align="center"
              style="background-color:#111827; padding:30px 24px;">
              <h1 style="margin:0; color:#ffffff; font-size:25px; letter-spacing:-0.5px;">
                Password Reset
              </h1>
              <p style="margin:10px 0 0; color:#d1d5db; font-size:14px; line-height:22px;">
                Secure access to your account
              </p>
            </td>
          </tr>

          <!-- Email Content -->
          <tr>
            <td style="padding:32px 28px 24px;">

              <p style="margin:0 0 18px; font-size:16px; line-height:25px;">
                Hello <strong><%= userName %></strong>,
              </p>

              <p style="margin:0 0 20px; color:#4b5563; font-size:14px; line-height:24px;">
                We received a request to reset the password associated with your account.
                Use the One-Time Password (OTP) below to verify your identity and continue
                resetting your password.
              </p>

              <!-- OTP Box -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
                style="background-color:#f9fafb; border:1px solid #e5e7eb; border-radius:12px;">
                <tr>
                  <td align="center" style="padding:24px 16px;">

                    <p style="margin:0 0 12px; color:#6b7280; font-size:12px; font-weight:bold; letter-spacing:1.5px;">
                      YOUR VERIFICATION CODE
                    </p>

                    <p style="margin:0; color:#111827; font-size:34px; font-weight:bold; letter-spacing:10px; font-family:monospace;">
                      <%= otp %>
                    </p>

                    <p style="margin:16px 0 0; color:#dc2626; font-size:13px; line-height:20px;">
                      Expires in <strong><%= expirationTime %> minutes</strong>
                    </p>

                  </td>
                </tr>
              </table>

              <p style="margin:24px 0 0; color:#4b5563; font-size:14px; line-height:23px;">
                Enter this code on the password reset page to proceed. For your security,
                do not share this OTP with anyone, including anyone claiming to be from our team.
              </p>

              <!-- Security Warning -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
                style="margin-top:24px; background-color:#fff7ed; border-left:4px solid #f97316; border-radius:6px;">
                <tr>
                  <td style="padding:16px;">
                    <p style="margin:0 0 6px; color:#9a3412; font-size:14px; font-weight:bold;">
                      Didn't request a password reset?
                    </p>

                    <p style="margin:0; color:#9a3412; font-size:13px; line-height:22px;">
                      If you did not request this OTP, please ignore this email.
                      Do not share the code with anyone. Your password will not be changed
                      unless the reset process is completed.
                    </p>
                  </td>
                </tr>
              </table>

              <p style="margin:24px 0 0; color:#4b5563; font-size:14px; line-height:23px;">
                Best regards,<br />
                <strong>The Support Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center"
              style="padding:20px 24px; background-color:#f9fafb; border-top:1px solid #e5e7eb;">

              <p style="margin:0; color:#9ca3af; font-size:12px; line-height:20px;">
                This is an automated email. Please do not reply to this message.
              </p>

              <p style="margin:8px 0 0; color:#9ca3af; font-size:11px;">
                &copy; <%= new Date().getFullYear() %> Your Application. All rights reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
